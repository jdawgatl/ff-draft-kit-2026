{
  "manifest_version": 3,
  "name": "2026 Fantasy Draft Kit — Live Draft Assistant",
  "description": "Custom-scored VORP rankings, recommendations, and a mock draft simulator that live-syncs with Yahoo fantasy draft rooms (real & mock).",
  "version": "1.0.0",
  "action": {
    "default_title": "Open Draft Kit",
    "default_popup": "dist/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "dist/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://football.fantasysports.yahoo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "identity"],
  "host_permissions": ["*://football.fantasysports.yahoo.com/*"],
  "minimum_chrome_version": "116"
}
